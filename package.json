{
  "name": "compass-maritime",
  "version": "0.1.0",
  "private": true,
  "description": "Gyro and magnetic compass error calculator for navigational officers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "build:single": "node scripts/build-single-file.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "icons": "node scripts/make-icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "ios:add": "npm run build && cap add ios",
    "ios:sync": "npm run build && cap sync ios"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@tauri-apps/cli": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
